# Copia este archivo como .env.local y llena los valores reales.
# .env.local NUNCA se sube a git (ya debería estar en .gitignore).

# ---- Firebase (lado cliente — configuración pública, no son secretos) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin SDK (SOLO servidor — esto SÍ es secreto) ----
# Pega aquí el contenido COMPLETO del archivo JSON de la service account,
# como un solo string (sin saltos de línea reales, usa \n si tu JSON los tiene).
# Se descarga desde: Firebase Console > Configuración del proyecto > Cuentas de servicio
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---- WhatsApp Business API (cuenta Meta "Titan") ----
# PENDIENTE: dar de alta un número nuevo dentro de Titan dedicado a este
# proyecto (ver ale-nota-proyecto-arranca.md, sección "pendiente técnico menor")
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- Cron job de marcado de mora ----
# Genera un string aleatorio largo, ej: openssl rand -hex 32
CRON_SECRET=
