rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /kyc-selfie-ine/{usuarioId}/{archivo} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == usuarioId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /kyc-tarjeta-circulacion/{usuarioId}/{archivo} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == usuarioId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /kyc-captura-perfil/{usuarioId}/{archivo} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == usuarioId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }


    match /comprobantes-pago/{usuarioId}/{archivo} {
      allow read: if false;
      allow write: if request.auth != null
                   && request.auth.uid == usuarioId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
